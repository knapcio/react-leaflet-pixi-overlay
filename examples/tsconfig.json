{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "leaflet": ["./node_modules/@types/leaflet"],
      "pixi.js": ["./node_modules/pixi.js/lib/index.d.ts"],
      "react": ["./node_modules/@types/react"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react-leaflet": ["./node_modules/react-leaflet/lib/index.d.ts"],
      "react-leaflet-pixi-overlay": ["../src/index.ts"],
      "supercluster": ["./node_modules/@types/supercluster"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts", "../src"]
}
